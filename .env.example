# Copy to .env for working without Doppler: `mise run dev:env`, `mise run test:env`.
# Ask a team member for the USOS keys. Never commit .env.

# Read by the API only when it runs on the host. The dev stack (compose.yaml) sets
# its own DATABASE_URL, PORT and ENV for the containers.
ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/app_dev?sslmode=disable

# Required: the API refuses to start without credentials for every USOS university.
UMCS_USOS_CONSUMER_KEY=
UMCS_USOS_CONSUMER_SECRET=
UMLUB_USOS_CONSUMER_KEY=
UMLUB_USOS_CONSUMER_SECRET=

# Required: email for OTP login. Ask a team member for the Resend key and template ID.
RESEND_API_KEY=
OTP_EMAIL_TEMPLATE_ID=
# At least 32 characters; generate with `openssl rand -base64 48`. Never change it once in use.
OTP_HASH_KEY=

# Optional; the defaults are shown.
# BACKEND_PUBLIC_URL=http://localhost:8080
# APP_WEB_URL=http://localhost:3000
# APP_MOBILE_SCHEME=uniezz://auth/callback
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# MAIL_FROM=Uniezz <no-reply@mail.uniezz.pl>
# Comma-separated emails accepted for OTP login at any OTP university. Startup fails if set in production.
# OTP_TEST_EMAILS=

# Optional: telemetry. Leave unset locally; everything still logs JSON to stdout.
# See docs/observability.md for the staging values.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=          # defaults to ENV
# SENTRY_RELEASE=              # defaults to the build SHA; leave unset
# OTEL_SERVICE_NAME=uniezz-api
# Full URLs from Sentry's OpenTelemetry tab, including /v1/traces and /v1/logs.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=x-sentry-auth=sentry sentry_key=<public key>
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=x-sentry-auth=sentry sentry_key=<public key>
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
